# ============================================================
# TOPUP STORE GATEWAY — SERVER WEB
# Pasangan proyek ini: fulfillment_backend (Server Topup)
# Kunci enkripsi & grup Telegram WAJIB selaras antar keduanya.
# ============================================================

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration (MySQL / MariaDB) — DB WEB lokal
DATABASE_URL=mysql://user:password@localhost:3306/db_store_web

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Global Business Logic Constants & Hold Balances
HOLD_BALANCE_MEMBER=0
HOLD_BALANCE_RESELLER=50000
HOLD_BALANCE_ADMIN=100000

# Rate Limiting & Anti-Spam (in seconds)
TRX_INTERVAL_SECONDS=10

# WhatsApp Gateway (OpenWA [github.com/rmyndharis/OpenWA] atau MPWA)
# OpenWA self-hosted:
# WA_GATEWAY_URL=http://127.0.0.1:3000/api/v1/send-message
# MPWA Cloud:
WA_GATEWAY_URL=https://mpwa.byllann.com/send-message
MPWA_API_KEY=
MPWA_SENDER_PHONE=
MPWA_ADMIN_PHONE=

# Payment Gateway Credentials (isi sesuai yang dipakai)
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=

TOKOPAY_MERCHANT_ID=
TOKOPAY_SECRET_KEY=

DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=

PAYDISINI_API_KEY=
PAYDISINI_MERCHANT_ID=

# Public base URL untuk callback webhook gateway (Duitku dll)
# PUBLIC_BASE_URL=https://domainanda.com

# ============================================================
# TELEGRAM — bus komunikasi terenkripsi ke Server Topup
# ============================================================
# Pengirim antrean batch utama (web -> topup)
TELEGRAM_BOT_SENDER_TOKEN=
# Pengirim kedua (round-robin, menggandakan kuota -> siklus 5 detik aman)
TELEGRAM_BOT_4_TOKEN=
# Listener status di sisi web (WAJIB beda bot dari listener fulfillment!)
TELEGRAM_CALLBACK_BOT_TOKEN=
# Grup listener web
TELEGRAM_GROUP_2_ID=-100xxxxxxxxxx
# Kunci HMAC — WAJIB sama persis dengan fulfillment_backend
TELEGRAM_ENCRYPTION_KEY=
# Opsional: fallback derivasi kunci bila ENCRYPTION_KEY kosong
# TELEGRAM_API_HASH=
